# ==============================================================================
# StockAssist AI — PRODUCTION runtime environment template (PH2.1, PH2.2)
#
# WHAT THIS FILE IS
# -----------------
# The deployment-time counterpart to backend/.env.example.
#
#   backend/.env.example    → a DEVELOPER's local machine. Generated from the
#                             secret registry; loaded off disk by python-dotenv.
#   production.env.example  → a CONTAINER's runtime environment. Copied to
#                             `production.env` (git-ignored), filled with real
#                             values, and injected by the platform:
#
#                                 docker run --env-file production.env ...
#                                 docker compose ...        (via `env_file`)
#
# WHAT THIS FILE IS **NOT** (PH2.2)
# ---------------------------------
# It is not the Docker Compose stack's configuration. Compose reads a SEPARATE
# project-root `.env` for its own `${...}` interpolation — database credentials,
# host ports, image tags. Template: `compose.env.example`.
#
#   .env            infrastructure credentials, owned by whoever runs the stack.
#                   The MongoDB ROOT password lives there and is handed ONLY to
#                   the mongo container.
#   production.env  THIS file — application secrets, injected into the BACKEND
#                   container and nowhere else.
#
# The split is a least-privilege boundary: the backend never receives the
# database root password, so code execution in the application cannot escalate
# to database administration. See docs/deployment/DOCKER_COMPOSE.md § 6.
#
# It is a separate file because the two audiences are different: this one omits
# every developer-only knob, defaults to the strict production posture, and is
# ordered by what an operator must decide rather than by code structure.
#
# HOW CONFIGURATION REACHES THE CONTAINER
# ---------------------------------------
# Only through the environment. No configuration file is baked into the image —
# `.dockerignore` excludes every dotenv file, so `load_dotenv()` in server.py
# finds nothing and the container's real environment variables are authoritative.
# That is what makes one image artifact deployable to staging and production
# unchanged: build once, test once, promote the same bytes.
#
# ⚠  THIS FILE CONTAINS PLACEHOLDERS ONLY AND IS COMMITTED TO GIT.
#    Never put a real secret here. Fill `production.env` instead — it matches
#    `*.env` in .gitignore and cannot be committed by accident.
#
# ⚠  AN --env-file IS A STEPPING STONE, NOT THE DESTINATION.
#    A plaintext secrets file on a deploy host is readable by anyone with shell
#    access and trivially leaked through `docker inspect`, a crash dump or a
#    backup. It is acceptable for a first production deploy; it is not the
#    end state. Graduate to the platform's secret manager as soon as the hosting
#    decision is made (PH2.7): AWS Secrets Manager / SSM Parameter Store,
#    Railway or Render variables, Kubernetes Secrets sourced from External
#    Secrets, or Docker Swarm secrets. See .claude/SECRETS.md.
#
# AUTHORITY
# ---------
# backend/security/secrets.py (SECRET_REGISTRY) is the single source of truth
# for which variables exist and which are mandatory in which environment. The
# container validates the whole set at startup (docker/entrypoint.sh) and
# REFUSES TO BOOT if anything required is missing, weak or still a placeholder.
# A missing value here therefore surfaces as a clear startup error, never as a
# 500 during a customer's first login.
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 1 — CONTAINER RUNTIME
# Consumed by docker/entrypoint.sh, not by the application code.
# ══════════════════════════════════════════════════════════════════════════════

# development | staging | production
# Drives the entire security posture: Secure/SameSite cookie flags, HSTS, CORS
# strictness, and whether a weak or placeholder secret is a warning or a fatal
# startup error. The image already defaults to `production`; it is restated here
# so the deployed configuration is explicit rather than implicit.
APP_ENV=production

# Bind address INSIDE the container. Must stay 0.0.0.0 — the container's network
# namespace is its own isolation boundary, and binding to 127.0.0.1 would make
# the service unreachable from the published port. Exposure to the outside world
# is controlled by port publishing and the firewall, not by the bind address.
HOST=0.0.0.0
PORT=8000

# uvicorn worker processes.
# ⚠  KEEP THIS AT 1, AND RUN EXACTLY ONE REPLICA. The application runs an
#    in-process APScheduler with no leader election — `server.py` calls
#    `setup_scheduler()` unconditionally at startup — so every additional
#    process fires every scheduled job again.
#
#    PH3.10 CORRECTION: this note used to say "scale horizontally with more
#    container replicas instead". That is unsafe. A replica is another process
#    running the same scheduler, so it duplicates jobs exactly as a worker does.
#    Redis fan-out (PH2.7) fixed the WebSocket half of multi-process; it did
#    NOT fix the scheduler half. `trade_monitor` runs every 60 s during market
#    hours and places REAL BROKER EXIT ORDERS on stop-loss and target hits —
#    two processes means two exit orders for one position, with real money.
#
#    Horizontal scaling is blocked on electing a single scheduler leader, not
#    on load balancing.
WEB_CONCURRENCY=1

# critical | error | warning | info | debug
# `debug` in production is a data-protection hazard, not just noise: it can put
# request bodies and headers into logs that are shipped to third-party systems.
LOG_LEVEL=info

# Whose X-Forwarded-For / X-Forwarded-Proto headers uvicorn is allowed to trust.
# The rate limiter keys anonymous traffic on the client IP, so trusting these
# headers from an arbitrary source lets a caller forge its IP and bypass
# throttling entirely. Set this to the address of YOUR reverse proxy / load
# balancer only. Use `*` only when the container is unreachable except through a
# trusted proxy AND that proxy overwrites the headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Seconds to let in-flight requests finish after SIGTERM. Keep it below the
# orchestrator's kill grace period (Docker: 10s default, override with
# `docker stop -t`; Kubernetes: terminationGracePeriodSeconds, default 30s) so
# connections drain instead of being severed mid-response on every deploy.
TIMEOUT_GRACEFUL_SHUTDOWN=20
TIMEOUT_KEEP_ALIVE=5

# Directory scanned for file-backed secrets (PH2.3). A file here named after a
# variable — lowercased — supplies that variable's value: /run/secrets/jwt_secret
# sets JWT_SECRET. This is exactly where Docker, Swarm and Kubernetes mount
# secrets, so the default needs changing only for a secret-manager sidecar that
# writes elsewhere (Vault's injector uses /vault/secrets).
SECRETS_DIR=/run/secrets

# Strict delivery posture. When true, a SENSITIVE secret arriving as a plaintext
# environment variable is a boot ERROR rather than a warning.
#
# Leave it false until every secret has been migrated to a file — with it on, the
# container refuses to start while anything is still set in this file. Turn it on
# once the migration is done: it converts "we intend to use Docker secrets" into
# a property the deployment cannot silently regress on.
REQUIRE_FILE_SECRETS=false


# ══════════════════════════════════════════════════════════════════════════════
# SECRET DELIVERY — EVERY VARIABLE BELOW HAS A `_FILE` FORM (PH2.3)
#
# Any variable in this file can be delivered as a FILE instead of a value:
#
#     JWT_SECRET=<the secret>                    ← plaintext (this file)
#     JWT_SECRET_FILE=/run/secrets/jwt_secret    ← a pointer to the secret
#
# The second form keeps the credential out of `docker inspect`, out of the
# container's environment, and out of every child process. A Docker secret
# mounted at /run/secrets/<lowercase-name> is picked up automatically, with no
# `_FILE` variable needed at all.
#
# ⚠ SET ONE OR THE OTHER, NEVER BOTH. Two sources for one secret means two
#   owners, and the backend refuses to start rather than guess which is current —
#   guessing is how a rotated secret gets shadowed by a stale one.
#
# Ready-made stack:   ./secrets/generate.sh
#                     docker compose -f docker-compose.yml \
#                                    -f docker-compose.secrets.yml up -d
# Full documentation: docs/deployment/SECRETS.md
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 2 — CORE (required; the container will not start without these)
# ══════════════════════════════════════════════════════════════════════════════

# MongoDB connection string. In production this is a managed cluster (Atlas or
# equivalent) with TLS and authentication — NOT a container on the same host.
# Requirements: dedicated least-privilege user (readWrite on this database only,
# never a cluster admin), IP allowlist or private networking, and a replica set
# so the TTL indexes and sessions survive a node failure.
#
# ⚠ UNDER DOCKER COMPOSE (PH2.2) THIS VALUE IS IGNORED.
#   docker-compose.yml builds MONGO_URL and DB_NAME itself, from the credentials
#   in the project-root `.env`, pointing at the in-stack `mongo` service. A
#   service's `environment:` block outranks its `env_file`, so a stale value here
#   can never break the stack's own wiring. Same for REDIS_URL below.
MONGO_URL=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=alpha_stock

# HS256 signing key for access + refresh JWTs; also the fallback HMAC key for
# CSRF and identity-recovery tokens. THE single most sensitive value in the
# system: anyone holding it can mint a valid session for any user.
#   Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Rules:     unique per environment (never reuse the staging key), never
#              committed, rotated on any suspicion of exposure. Startup
#              validation rejects short or placeholder-looking values.
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Public origin of the SPA. Used for OAuth redirect construction and links in
# transactional email. Must be the exact https origin, no trailing slash.
FRONTEND_URL=https://app.example.com

# Exact-match CORS allowlist, comma-separated. NEVER `*` — the API authenticates
# with cookies, and a wildcard origin with credentials is a cross-site request
# forgery primitive. List every origin that legitimately calls the API.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 3 — AI PROVIDERS (at least one is required in production)
# The AI engine is the product. With neither key set, startup validation fails.
# ══════════════════════════════════════════════════════════════════════════════

ANTHROPIC_API_KEY=
GOOGLE_GEMINI_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 4 — OPTIONAL SIGNING KEYS
# Each falls back to JWT_SECRET when unset. Setting dedicated keys is the better
# posture: it means a CSRF-token key rotation does not invalidate every live
# login session, and blast radius is contained per token class.
# ══════════════════════════════════════════════════════════════════════════════

CSRF_SECRET=
RECOVERY_SECRET=


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 5 — OPTIONAL INTEGRATIONS
# Every one of these is feature-gated: the platform starts and serves without
# them, with the corresponding feature reporting itself as unconfigured. Enable
# them deliberately, one at a time, and verify each in staging first.
# ══════════════════════════════════════════════════════════════════════════════

# ── Google OAuth ("Continue with Google") — set BOTH or neither ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Market data fallback ──────────────────────────────────────────────────────
# All market data flows through the Market Gateway / Source Manager; this is one
# provider behind it, never called directly by business logic.
ALPHA_VANTAGE_KEY=

# ── Brokerage integration — each pair is both-or-neither ──────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=https://api.example.com/api/zerodha/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=https://api.example.com/api/brokers/upstox/callback

# Fernet key encrypting broker access tokens at rest. Derived from JWT_SECRET
# when unset — set it explicitly in production so that rotating JWT_SECRET after
# an incident does not simultaneously render every stored broker token
# undecryptable.
#   Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_TOKEN_KEY=

# ── Transactional email — SendGrid (A) or SMTP (B), not both ──────────────────
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@example.com
EMAIL_FROM_NAME=StockAssist AI

# ── WhatsApp alerts (Twilio) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
USER_WHATSAPP_TO=

# ── Telegram alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Inbound automation webhooks (n8n) ─────────────────────────────────────────
# Shared secret required in the X-Webhook-Key header. Leave empty to keep the
# webhook surface disabled; a weak value here is an unauthenticated write path.
WEBHOOK_API_KEY=

# ── Redis (shared cache + cross-process realtime fan-out) ─────────────────────
# Not required while WEB_CONCURRENCY=1 and there is a single replica. Becomes
# mandatory the moment the deployment scales to multiple replicas, since
# WebSocket fan-out is in-memory until then. Configured properly in PH2.8.
#
# ⚠ UNDER DOCKER COMPOSE (PH2.2) THIS VALUE IS IGNORED — Compose composes it
#   from REDIS_PASSWORD in the project-root `.env` and points it at the in-stack
#   `redis` service. Redis is part of the base compose stack precisely so the
#   local stack has the same cross-process semantics as a scaled deployment.
REDIS_URL=


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 6 — MUST NOT APPEAR IN A PRODUCTION ENVIRONMENT
#
# Listed explicitly, and left commented out, so that their absence is a
# deliberate decision on the record rather than an oversight. Startup validation
# actively rejects several of them when APP_ENV=production.
# ══════════════════════════════════════════════════════════════════════════════

# ENABLE_AUTO_LOGIN=false   ← dev convenience that bypasses authentication
# ADMIN_EMAIL=...           ← dev-seed only; the seeder refuses to run in prod
# ADMIN_PASSWORD=...        ← dev-seed only; a weak value here is a prod backdoor
