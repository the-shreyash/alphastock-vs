# ==============================================================================
# StockAssist AI — Backend environment template
#
# Generated from backend/security/secrets.py (SECRET_REGISTRY) by
# scripts/generate_env_example.py — DO NOT edit by hand; add the variable to
# the registry and re-run the generator instead.
#
# Copy to backend/.env and fill in real values. This file is committed and
# MUST contain placeholders only — never a real secret.
# ==============================================================================

# ── CORE APPLICATION CONFIGURATION (required in every environment) ────────────
# MongoDB connection string (may embed credentials).  [SECRET; required in: development, production, staging, testing]
MONGO_URL=mongodb://localhost:27017

# MongoDB database name.  [required in: development, production, staging, testing]
DB_NAME=alpha_stock_db

# ── APPLICATION CONFIGURATION ─────────────────────────────────────────────────
# Deployment environment: development | testing | staging | production.  [optional]
APP_ENV=development

# Public origin of the SPA; used for OAuth redirects and links.  [required in: production, staging]
FRONTEND_URL=http://localhost:3000

# Comma-separated exact-match CORS origin allowlist (never '*'). See security/cors.py.  [required in: production]
CORS_ALLOWED_ORIGINS=https://app.stockassist.ai,https://www.stockassist.ai

# Directory scanned for file-backed secrets (Docker/Swarm/K8s mount point).  [optional]
SECRETS_DIR=/run/secrets

# When true, every sensitive secret MUST arrive from a file; plaintext env delivery becomes a boot error.  [optional]
REQUIRE_FILE_SECRETS=false

# Application version reported by /api/diagnostics and the app_info metric. Set from the Docker build arg of the same name; defaults to 0.0.0-dev.  [optional]
APP_VERSION=0.0.0-dev

# Git commit this build came from; reported by /api/diagnostics. Set by CI at image build time.  [optional]
VCS_REF=

# ISO-8601 image build timestamp; reported by /api/diagnostics. Set by CI at image build time.  [optional]
BUILD_DATE=

# Root log level: DEBUG | INFO | WARNING | ERROR (case-insensitive). Defaults to INFO; an unrecognized value falls back to INFO rather than failing the boot. docker/entrypoint.sh separately normalizes this to lowercase for uvicorn's own --log-level flag, which is case-sensitive.  [optional]
LOG_LEVEL=info

# Log output format: json | text. Defaults to json in production, text elsewhere.  [optional]
LOG_FORMAT=text

# Blank credential-shaped values (token=..., password=...) inside free-text log messages. Defaults to on; turn off only to debug the scrubber itself.  [optional]
LOG_SCRUB_MESSAGES=1

# Access-log health/metrics probe traffic. Off by default — a 10s probe cadence across replicas is tens of thousands of identical lines a day. Metrics still count every probe.  [optional]
LOG_HEALTH_REQUESTS=0

# Write structured logs to rotated files IN ADDITION to stdout. Off by default. Enable for a host with no log collector, or where a retention rule requires logs on durable storage. Never replaces stdout, so `docker logs` and any attached collector are unaffected.  [optional]
LOG_TO_FILES=0

# Directory for log files when LOG_TO_FILES is on. Defaults to /var/log/stockassist (the FHS location, pre-created in the image and owned by the runtime user). An unwritable directory degrades to stdout-only with a warning rather than failing the boot.  [optional]
LOG_DIR=/var/log/stockassist

# Comma-separated subset of streams to write to file: application, access, security, audit, error. Defaults to all five. Use a subset when a collector already takes everything but the audit trail must also be retained locally (LOG_FILE_STREAMS=audit,security).  [optional]
LOG_FILE_STREAMS=

# Size at which a log file is rotated (default 52428800 = 50 MB). Clamped to [64 KiB, 2 GiB]; an out-of-range value is clamped with a warning, never rejected.  [optional]
LOG_FILE_MAX_BYTES=52428800

# Rotated segments kept per stream (default 10). With the default size that bounds one stream at ~550 MB uncompressed, ~100 MB gzipped. Zero means bound the live file and keep no history.  [optional]
LOG_FILE_BACKUP_COUNT=10

# Maximum age of a rotated segment (default 14). Applied BEFORE the backup count, so an age-based retention commitment is honoured even when the count would have kept the segment. Zero disables age-based pruning and leaves the count as the only bound.  [optional]
LOG_RETENTION_DAYS=14

# Gzip rotated segments (default on). JSON logs compress at roughly 10:1. Compression runs on the log writer thread, never on a request.  [optional]
LOG_FILE_COMPRESS=1

# Records buffered between the application and the log writer thread (default 10000, clamped to [100, 1000000]). The queue is what keeps disk I/O off the event loop. When it is full records are DROPPED, not blocked on, and counted by the log_records_dropped_total metric.  [optional]
LOG_QUEUE_SIZE=10000

# ── SIGNING SECRETS (optional dedicated keys; fall back to JWT_SECRET) ────────
# HS256 signing key for access/refresh JWTs; also the fallback HMAC key for CSRF & recovery tokens.  [SECRET; required in: development, production, staging, testing]
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Optional dedicated HMAC key for CSRF tokens; falls back to JWT_SECRET when unset.  [SECRET; optional]
CSRF_SECRET=

# Optional dedicated HMAC key for email-verify / password-reset tokens; falls back to JWT_SECRET.  [SECRET; optional]
RECOVERY_SECRET=

# ── AI PROVIDERS (at least one REQUIRED in production) ────────────────────────
# Anthropic (Claude) API key for the AI engine.  [SECRET; optional]
ANTHROPIC_API_KEY=

# Google Gemini API key for the dual-model AI debate.  [SECRET; optional]
GOOGLE_GEMINI_KEY=

# ── GOOGLE OAUTH 2.0 (optional; set BOTH or neither) ──────────────────────────
# Google OAuth 2.0 client id ('Continue with Google').  [optional]
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 client secret.  [SECRET; optional]
GOOGLE_CLIENT_SECRET=

# ── EXTERNAL MARKET DATA (optional fallback) ──────────────────────────────────
# Alpha Vantage API key (intraday fallback source).  [SECRET; optional]
ALPHA_VANTAGE_KEY=

# ── BROKERAGE INTEGRATION (optional; each pair is both-or-neither) ────────────
# Zerodha Kite Connect API key.  [SECRET; optional]
KITE_API_KEY=

# Zerodha Kite Connect API secret.  [SECRET; optional]
KITE_API_SECRET=

# Zerodha OAuth redirect URL.  [optional]
KITE_REDIRECT_URL=http://localhost:8000/api/zerodha/callback

# Upstox API key.  [SECRET; optional]
UPSTOX_API_KEY=

# Upstox API secret.  [SECRET; optional]
UPSTOX_API_SECRET=

# Upstox OAuth redirect URL.  [optional]
UPSTOX_REDIRECT_URL=http://localhost:8000/api/brokers/upstox/callback

# Angel One SmartAPI key.  [SECRET; optional]
ANGELONE_API_KEY=

# Angel One SmartAPI publisher-login redirect URL.  [optional]
ANGELONE_REDIRECT_URL=http://localhost:8000/api/brokers/angelone/callback

# Fyers API v3 app id (client id).  [SECRET; optional]
FYERS_APP_ID=

# Fyers API v3 secret id.  [SECRET; optional]
FYERS_SECRET_ID=

# Fyers OAuth redirect URL.  [optional]
FYERS_REDIRECT_URL=http://localhost:8000/api/brokers/fyers/callback

# Dhan partner id (DhanHQ v2 partner consent flow).  [SECRET; optional]
DHAN_PARTNER_ID=

# Dhan partner secret; sent as a request header, never in a URL.  [SECRET; optional]
DHAN_PARTNER_SECRET=

# Dhan partner-consent redirect URL; receives ?tokenId= on success.  [optional]
DHAN_REDIRECT_URL=http://localhost:8000/api/brokers/dhan/callback

# Optional Fernet key encrypting broker tokens at rest; derived from JWT_SECRET when unset.  [SECRET; optional]
BROKER_TOKEN_KEY=

# ── TRANSACTIONAL NOTIFICATIONS (optional) ────────────────────────────────────
# Twilio account SID (WhatsApp alerts).  [SECRET; optional]
TWILIO_ACCOUNT_SID=

# Twilio auth token.  [SECRET; optional]
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp sender number.  [optional]
TWILIO_WHATSAPP_FROM=+14155238886

# Default WhatsApp recipient number.  [optional]
USER_WHATSAPP_TO=

# SendGrid API key (transactional email — option A).  [SECRET; optional]
SENDGRID_API_KEY=

# SMTP host (transactional email — option B).  [optional]
SMTP_HOST=

# SMTP port.  [optional]
SMTP_PORT=587

# SMTP username.  [SECRET; optional]
SMTP_USER=

# SMTP password.  [SECRET; optional]
SMTP_PASSWORD=

# From address for outbound email.  [optional]
EMAIL_FROM=alerts@alphapartner.ai

# From display name for outbound email.  [optional]
EMAIL_FROM_NAME=AlphaPartner

# Shared secret for inbound n8n automation webhooks (X-Webhook-Key header).  [SECRET; optional]
WEBHOOK_API_KEY=

# Telegram bot token (optional alert channel).  [SECRET; optional]
TELEGRAM_BOT_TOKEN=

# Telegram chat id for alerts.  [optional]
TELEGRAM_CHAT_ID=

# ── INFRASTRUCTURE (optional) ─────────────────────────────────────────────────
# Redis connection URL for cross-process realtime fan-out; single-process/dev works without it.  [SECRET; optional]
REDIS_URL=

# Connection-pool ceiling per process (default 24). Bounds how many sockets a traffic burst can open against Redis; raising it is rarely the fix for slowness, since a saturated pool usually means a slow command rather than too few connections.  [optional]
REDIS_MAX_CONNECTIONS=24

# TCP connect timeout (default 1.5). Must stay below HEALTH_PROBE_TIMEOUT_SECONDS or a slow-to-accept Redis makes the readiness probe time out instead of reporting a failed Redis check.  [optional]
REDIS_CONNECT_TIMEOUT_SECONDS=1.5

# Per-command timeout (default 2.0). Redis answers in microseconds, so reaching this means the server is blocked and waiting longer only ties up the event loop.  [optional]
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# PING a pooled connection before use if idle longer than this (default 30). What makes a Redis RESTART invisible: without it the first operations after a restart each fail once on a stale pooled socket.  [optional]
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# Retries after the first attempt, for connection errors and timeouts only (default 2). Covers one dead pooled connection without turning a real outage into a latency multiplier.  [optional]
REDIS_RETRY_ATTEMPTS=2

# Consecutive connection failures before the circuit breaker opens and the process degrades to its in-memory cache (default 5). One failure is noise; five in a row is a dependency.  [optional]
REDIS_CIRCUIT_FAILURE_THRESHOLD=5

# How long the breaker stays open before admitting one trial operation (default 10). Long enough not to hammer a down Redis, short enough to notice recovery within a few seconds.  [optional]
REDIS_CIRCUIT_RESET_SECONDS=10

# Cadence of the background INFO sample that fills the redis_server_* metrics (default 30; 0 disables). Sampled on a timer, never at scrape time, so a metrics scraper cannot drive load onto Redis.  [optional]
REDIS_STATS_INTERVAL_SECONDS=30

# Shared secret required to read /api/metrics and /api/diagnostics IN PRODUCTION. Unset in production, both endpoints fail closed with 403. Presented as 'Authorization: Bearer <token>' or 'X-Metrics-Token'.  [SECRET; optional]
METRICS_TOKEN=generate-with: python -c "import secrets;print(secrets.token_urlsafe(32))"

# Serve /api/metrics and /api/diagnostics without a token in production. ONLY for a deployment where those paths are unreachable from outside (private scrape network / mesh-only listener).  [optional]
METRICS_ALLOW_UNAUTHENTICATED=

# Per-metric ceiling on distinct label combinations (default 500). A backstop against a mislabelling bug exhausting memory; overflow is counted by the metrics_series_dropped_total gauge.  [optional]
METRICS_MAX_SERIES=500

# Per-dependency readiness probe timeout (default 2.0). Must stay well below the load balancer's probe timeout.  [optional]
HEALTH_PROBE_TIMEOUT_SECONDS=2.0

# How long a readiness result is reused (default 2.0). Prevents several independent pollers from generating continuous ping load on MongoDB.  [optional]
HEALTH_CACHE_TTL_SECONDS=2.0

# ── DEVELOPER FLAGS & DEV-ONLY SEED VALUES ────────────────────────────────────
# Dev-seed admin email (scripts/seed_dev_admin.py only).  [optional]
ADMIN_EMAIL=admin@alphapartner.com

# Dev-seed admin password (scripts/seed_dev_admin.py only; the seeder refuses to run in production).  [SECRET; optional]
ADMIN_PASSWORD=

# Dev convenience flag; MUST be false/unset in production.  [optional]
ENABLE_AUTO_LOGIN=false
