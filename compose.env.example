# ==============================================================================
# StockAssist AI — Docker Compose stack variables (PH2.2)
#
# WHAT THIS FILE IS
# -----------------
# The template for the project-root `.env` that DOCKER COMPOSE ITSELF reads.
#
#     cp compose.env.example .env      # then fill in every REPLACE_ value
#
# Compose loads `./.env` automatically and uses it to resolve the `${...}`
# interpolations in docker-compose.yml. These values configure the STACK:
# database credentials, image tags, host port bindings.
#
# THIS IS NOT THE BACKEND'S ENVIRONMENT.
# The backend container receives `production.env` (see production.env.example),
# injected via `env_file`. Two files, because they are two different trust
# domains:
#
#     .env            infrastructure credentials — owned by whoever runs the
#                     stack. The MongoDB ROOT password lives here and is handed
#                     ONLY to the mongo container. The backend never sees it, so
#                     code execution in the application cannot escalate to
#                     database administration.
#
#     production.env  application secrets — JWT signing key, AI provider keys,
#                     broker credentials. Injected into the backend container.
#
# ⚠  THIS FILE IS COMMITTED TO GIT AND CONTAINS PLACEHOLDERS ONLY.
#    Your real `.env` matches `.env` in .gitignore and cannot be committed by
#    accident. Never put a real credential here.
#
# ⚠  IF YOU ALREADY HAVE A PROJECT-ROOT `.env`
#    (the pre-PH2.2 compose file used one for JWT_SECRET, API keys and so on):
#    APPEND the variables below to it rather than overwriting it. The
#    application secrets it already contains are no longer read by Compose —
#    move them into `production.env`.
#
# GENERATING THE PASSWORDS
# ------------------------
# Every credential below must be URL-safe: three of them are interpolated into
# connection URIs (mongodb://user:PASSWORD@host, redis://:PASSWORD@host), where
# an unescaped `@`, `:`, `/` or `#` silently truncates the URI and produces an
# authentication failure that looks nothing like its cause. `token_urlsafe`
# emits only [A-Za-z0-9_-], which is safe in every position:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Or generate the whole set at once:
#
#     python3 - <<'EOF' >> .env
#     import secrets
#     for k in ("MONGO_ROOT_PASSWORD", "MONGO_APP_PASSWORD", "REDIS_PASSWORD",
#               "MONGO_EXPRESS_PASSWORD", "N8N_BASIC_AUTH_PASSWORD"):
#         print(f"{k}={secrets.token_urlsafe(32)}")
#     EOF
#
# Full documentation: docs/deployment/DOCKER_COMPOSE.md
# ==============================================================================


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 1 — MONGODB
# ══════════════════════════════════════════════════════════════════════════════

# Application database name. Used in three places that must agree: the database
# the init script provisions, the `authSource` in the backend's MONGO_URL, and
# the backend's DB_NAME. Compose derives all three from this one variable, so it
# is set once, here.
MONGO_DB_NAME=alpha_stock

# Cluster ROOT account. Created by the mongo image on first boot; used for
# operator tasks only (backups, index surgery, user management) and by Mongo
# Express in the development overlay. NOT used by the application.
MONGO_ROOT_USERNAME=stockassist_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_URL_SAFE_PASSWORD

# Least-privilege APPLICATION account: `readWrite` on MONGO_DB_NAME and nothing
# else. Created by docker/mongodb/init-app-user.js on first boot. This is the
# identity the backend authenticates with.
#
# ⚠ Both accounts are created ONLY when the data volume is empty. Changing a
#   password here after the first `up` has no effect — see the troubleshooting
#   section of docs/deployment/DOCKER_COMPOSE.md for how to rotate it in place.
MONGO_APP_USERNAME=stockassist_app
MONGO_APP_PASSWORD=REPLACE_WITH_GENERATED_URL_SAFE_PASSWORD

# Pinned to a minor version: patches arrive on `docker compose pull`, a major
# version upgrade never happens by accident. MongoDB majors change index and
# wire-protocol semantics — that is a migration, not an update.
MONGO_IMAGE_TAG=7.0


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 2 — REDIS
# ══════════════════════════════════════════════════════════════════════════════

# Required. An unauthenticated Redis on a shared network is a remote code
# execution primitive, not just a data leak: CONFIG SET dir + SAVE writes
# arbitrary files as the redis user.
REDIS_PASSWORD=REPLACE_WITH_GENERATED_URL_SAFE_PASSWORD

REDIS_IMAGE_TAG=7.2-alpine

# Memory ceiling and eviction policy. Everything the application stores in Redis
# is reconstructible cache or transient pub/sub state, so evicting the
# least-recently-used key always beats refusing a write. Raise the ceiling for a
# larger working set; do not remove it — an unbounded Redis ends as an OOM kill.
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 3 — BACKEND SERVICE
# ══════════════════════════════════════════════════════════════════════════════

# Path to the backend's application environment file, injected via `env_file`.
# Compose fails to start if it does not exist — deliberate: a production-shaped
# stack must never boot with an unknown configuration.
#
# For the hardened alternative — credentials delivered as file-mounted Docker
# secrets instead of environment variables — add the PH2.3 overlay:
#
#     ./secrets/generate.sh
#     docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d
#
# The overlay is additive and gradual: this file keeps working unchanged, and
# each secret can be migrated on its own. See docs/deployment/SECRETS.md.
BACKEND_ENV_FILE=./production.env

# Host port publishing. The container always listens on BACKEND_CONTAINER_PORT;
# BACKEND_PORT is what that maps to on the host.
BACKEND_PORT=8000
BACKEND_CONTAINER_PORT=8000

# ⚠ KEEP THIS AT 127.0.0.1 unless the machine's network boundary is enforced
#   somewhere Docker cannot bypass (a cloud security group, or a reverse proxy
#   in front — PH2.11). Docker writes published ports into the DOCKER-USER
#   iptables chain, which is evaluated BEFORE ufw and firewalld: a 0.0.0.0 bind
#   is reachable from the network even when the host firewall says it is not.
BACKEND_BIND_ADDR=127.0.0.1

# Image coordinates. With `build:` present, Compose builds and tags locally.
# Point these at a registry to run a CI-built image instead and Compose will
# pull it (PH2.6):
#     BACKEND_IMAGE=ghcr.io/the-shreyash/stockassist-backend
#     BACKEND_IMAGE_TAG=1.4.0
BACKEND_IMAGE=stockassist-backend
BACKEND_IMAGE_TAG=local

# OCI provenance labels baked into the image at build time. CI supplies the real
# values; locally they stay at their defaults.
#     VCS_REF=$(git rev-parse --short HEAD)
#     BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
APP_VERSION=0.0.0-dev
VCS_REF=unknown
BUILD_DATE=unknown

# uvicorn worker processes. KEEP AT 1: the in-process scheduler and the
# in-memory WebSocket registry are not multi-process safe until PH2.8. Scale
# with replicas, not workers.
WEB_CONCURRENCY=1

# Overrides the image default (`production`). The development overlay
# (docker-compose.override.yml) sets `development` when this is unset; set it
# explicitly to `production` to rehearse the strict startup path locally.
# APP_ENV=production
# LOG_LEVEL=info


# ══════════════════════════════════════════════════════════════════════════════
# SECTION 4 — DEVELOPMENT TOOLING
#
# Read only by docker-compose.override.yml. The production stack
# (`docker compose -f docker-compose.yml ...`) ignores every variable below, and
# none of these services exists in it.
# ══════════════════════════════════════════════════════════════════════════════

# Host ports for direct database access from host tooling (mongosh, redis-cli,
# Compass). Always published on loopback only.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379

# ── Mongo Express (http://127.0.0.1:8081) ─────────────────────────────────────
# Required, no default. Mongo Express shipped admin/pass as its documented
# default for years and became one of the most commonly found exposed admin
# panels on the internet. It holds the MongoDB root credentials.
MONGO_EXPRESS_USERNAME=dev
MONGO_EXPRESS_PASSWORD=REPLACE_WITH_GENERATED_URL_SAFE_PASSWORD
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_IMAGE_TAG=1.0.2

# ── Redis Insight — opt-in: docker compose --profile tools up -d ──────────────
REDISINSIGHT_PORT=5540
REDISINSIGHT_IMAGE_TAG=2.60

# ── n8n automation editor — opt-in: docker compose --profile automation up -d ─
# No credentials here: n8n 1.x removed the N8N_BASIC_AUTH_* variables (they are
# silently ignored, verified in PH2.2). Access control is n8n's own owner
# account, created on the first browser visit — complete that setup immediately
# after the first `up`.
N8N_PORT=5678
N8N_IMAGE_TAG=1.70.0
# Must match WEBHOOK_API_KEY in production.env, or the backend rejects inbound
# automation calls on the X-Webhook-Key check. Leave empty to keep the inbound
# webhook surface disabled.
WEBHOOK_API_KEY=
