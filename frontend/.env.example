# ==============================================================================
# StockAssist AI — Frontend environment template
#
# Copy to frontend/.env and adjust. Create React App only exposes variables
# prefixed REACT_APP_* to the browser bundle, so NEVER put a secret here — every
# value in this file is public and shipped to the client. Secrets belong in the
# backend environment only (see backend/.env.example).
#
# HOSTED BUILDS (Vercel): these are set in the Vercel project's Environment
# Variables, not in a file, and are baked in at BUILD time — changing one needs
# a redeploy. scripts/verify-deploy-env.js refuses a hosted build whose
# REACT_APP_BACKEND_URL is missing, not https, or not a bare origin, and any
# REACT_APP_* name that looks like a secret. See docs/deployment/VERCEL.md.
# ==============================================================================

# Backend API origin the SPA talks to: scheme + host [+ port], no path, no
# trailing slash. The WebSocket URL is derived from it (https -> wss).
#   local:      http://localhost:8000
#   production: https://api.example.com
REACT_APP_BACKEND_URL=http://localhost:8000

# Google OAuth 2.0 *client id* — a public identifier (not the client secret,
# which stays server-side). Enables the "Continue with Google" button.
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
