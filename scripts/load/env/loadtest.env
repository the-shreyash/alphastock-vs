# ==============================================================================
# StockAssist AI — PH3.5 load-test environment
#
# WHY THIS FILE IS COMMITTED
# --------------------------
# A load test is only useful if it is repeatable (brief §21), and it is not
# repeatable unless the environment it ran against is written down exactly.
# Every value here is **synthetic and obviously so** — the same principle as
# `backend/tests/_testenv.py`, which is also committed. Nothing in this file is
# a credential for anything that exists.
#
# ⚠  NEVER source this in production, and never point it at a production
#    MONGO_URL, REDIS_URL, or provider key. The database name and Redis DB index
#    below are deliberately unmistakable so an accidental run lands somewhere
#    harmless and obviously wrong rather than in real data.
#
# APP_ENV=staging is chosen deliberately over `development` or `testing`:
# `security/secrets.py` classifies those two as LENIENT_ENVIRONMENTS, which
# relaxes configuration gates. A capacity number measured with relaxed security
# configuration would not describe the deployment it is supposed to predict.
# `staging` runs every gate that is not keyed specifically on `== production`.
#
# Full documentation: docs/performance/PH3.5_LOAD_TEST_CERTIFICATION.md §2–§3
# ==============================================================================

# --- the line that makes every other line in this file take effect ----------- #
# `backend/server.py` line 6 is:
#
#     load_dotenv(ROOT_DIR / '.env', override=True)
#
# It runs at *import* time and `override=True` means the developer's
# `backend/.env` wins over anything exported into the environment. Without the
# kill switch below, sourcing this file and starting the server produces a
# process that silently runs against **the development database and the
# developer's real provider credentials** — verified during PH3.5 setup, where
# exactly that happened: the environment showed DB_NAME=stockassist_loadtest and
# the application wrote to alpha_stock_db. Every login 401'd, which looked like a
# seeding bug for twenty minutes.
#
# `PYTHON_DOTENV_DISABLED` is python-dotenv's own supported switch
# (`dotenv/main.py::_load_dotenv_disabled`), so `load_dotenv` becomes a no-op
# rather than something the harness has to monkeypatch. This is the same
# mechanism, for the same reason, as `backend/tests/_testenv.py` (PH3.1).
#
# ⚠  Do not remove this line. It is the only thing standing between a load test
#    and the developer's real Anthropic key.
PYTHON_DOTENV_DISABLED=1

# --- application ------------------------------------------------------------ #
APP_ENV=staging
APP_VERSION=0.0.0-loadtest
VCS_REF=0000000000000000000000000000000000000000
BUILD_DATE=1970-01-01T00:00:00Z
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- datastores -------------------------------------------------------------- #
# A dedicated database and a dedicated Redis logical DB. `stockassist_loadtest`
# appears in no other configuration file in this repository; that is the point.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=stockassist_loadtest
REDIS_URL=redis://127.0.0.1:6379/1

# --- secrets the application itself uses ------------------------------------- #
# Long enough to satisfy the real validators, and self-evidently not real.
JWT_SECRET=ph35-loadtest-jwt-secret-not-a-real-secret-0000
CSRF_SECRET=ph35-loadtest-csrf-secret-not-a-real-secret-000
RECOVERY_SECRET=ph35-loadtest-recovery-secret-not-a-real-secret
WEBHOOK_API_KEY=ph35-loadtest-webhook-key
# Valid 44-char urlsafe-base64 Fernet key. Decodes to the ASCII bytes
# b"stockassist-ph35-load-fernet-key", so it is self-evidently synthetic.
BROKER_TOKEN_KEY=c3RvY2thc3Npc3QtcGgzNS1sb2FkLWZlcm5ldC1rZXk=

# --- provider redirection (the whole point of this file) --------------------- #
# Market data: every Yahoo Finance request is issued against the local mock
# instead. See backend/services/real_market.py::yahoo_origin for why this exists
# and why the default is the real host.
MARKET_DATA_YAHOO_BASE=http://127.0.0.1:9020

# AI: the `anthropic` SDK's own supported base-URL override. The key must be
# non-empty for `services/claude_provider.py::is_configured()` to return True —
# without it the AI routes take an instant offline fallback and the "what
# happens while N requests wait on the provider" question is never asked.
ANTHROPIC_API_KEY=loadtest-mock-key-not-a-real-credential
ANTHROPIC_BASE_URL=http://127.0.0.1:9030

# --- third-party credentials: deliberately unconfigured ---------------------- #
# Empty string reads as "not configured" to every `*_configured()` check, so
# these subsystems take their offline path and no request leaves the machine.
# Gemini is left unconfigured so the model router resolves to the single mocked
# provider (Claude) deterministically — two live providers would make which one
# served a request a coin flip, and the AI latency figures unattributable.
GOOGLE_GEMINI_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALPHA_VANTAGE_KEY=
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
USER_WHATSAPP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@loadtest.invalid
# Quoted: unquoted parentheses are glob syntax in zsh, and `set -a; . file`
# under zsh fails the line rather than assigning it.
EMAIL_FROM_NAME="StockAssist AI (load test)"

# --- background work --------------------------------------------------------- #
# The heartbeat/AI engine, the 10s market broadcast loop and the scheduler all
# generate load of their own on a timer. They are LEFT ENABLED (=0) for the
# API scenarios, because a capacity figure measured with the background workers
# switched off would describe a deployment that does not exist — PH3.4 §21.4
# specifically flagged that those workers compete with request traffic for the
# same connection pool, and confirming that is part of this sprint's job.
# The failure-injection runs set this to 1 where isolating the request path
# is what is being measured; the certification records which runs did.
DISABLE_BACKGROUND_ENGINE=0

# --- observability ----------------------------------------------------------- #
# /api/metrics and /api/diagnostics are token-gated outside development. The
# harness passes this token so it can scrape server-side latency histograms and
# resource gauges without weakening the control.
METRICS_TOKEN=ph35-loadtest-metrics-token
# Redis server gauges (memory, clients, evictions) are sampled on this cadence.
# 10s rather than the 30s default so a run of a few minutes yields enough
# samples to see a trend rather than a single point.
REDIS_STATS_INTERVAL_SECONDS=10

# --- logging ------------------------------------------------------------------ #
# WARNING rather than INFO. At the concurrency levels under test, INFO-level
# request logging is itself a measurable cost and would be attributed to the
# application. The log pipeline is exercised separately by PH2.6's own tests.
LOG_LEVEL=WARNING
LOG_FORMAT=json
